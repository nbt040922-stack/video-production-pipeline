PIPELINE_ENV=production
PIPELINE_HOST=0.0.0.0
PIPELINE_PORT=8000
# Không còn dùng từ M08. Giữ trống để tương thích cấu hình cũ.
PIPELINE_ACCESS_PASSWORD=
PIPELINE_SESSION_SECRET=
PIPELINE_SESSION_TTL_HOURS=12
PIPELINE_DATABASE_PATH=data/pipeline.db
PIPELINE_MAX_ACTIVE_JOBS_PER_USER=5
PIPELINE_MAX_CONCURRENT_JOBS=1
PIPELINE_MAX_QUEUED_JOBS=20
PIPELINE_DUPLICATE_WINDOW_SECONDS=60
PIPELINE_MIN_FREE_DISK_GB=30
PIPELINE_JOB_RETENTION_DAYS=7
PIPELINE_MAX_COMPLETED_JOBS=100
PIPELINE_FRONTEND_DIST=dist
PIPELINE_LOG_DIR=logs
PIPELINE_ALLOW_INSECURE=false
PIPELINE_DEV_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

PIPELINE_WORKSPACE=workspace
SOURCE_MAX_DURATION_SECONDS=0
SOURCE_DOWNLOAD_TIMEOUT_SECONDS=1800
SOURCE_MAX_HEIGHT=1080
YTDLP_MODE=python
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
HOOK_ENGINE_PATH=
HOOK_ENGINE_PYTHON=
HOOK_MOTION_ID=motion1
HOOK_ENGINE_SERVER=http://127.0.0.1:8188
HOOK_ENGINE_TIMEOUT_SECONDS=7200
HOOK_ENGINE_SEED=42
HOOK_MIN_COMPATIBILITY=0.35
HOOK_DURATION_TOLERANCE_SECONDS=0.25
REVIEW_ENGINE_PATH=engines/review-engine
REVIEW_ENGINE_PYTHON=python
REVIEW_ENGINE_TIMEOUT_SECONDS=14400
REVIEW_VOICE_REFERENCE_PATH=
REVIEW_VOICE_REFERENCE_TEXT=
REVIEW_LLM_PROVIDER=
REVIEW_LLM_MODEL=
REVIEW_LLM_FALLBACK_ENABLED=true
OPENAI_API_KEY=
GEMINI_API_KEY=
TWELVE_LABS_API_KEY=
# Có thể dùng TWELVE_API_KEY làm tên tương thích thay thế.
USE_PROXY_VIDEO=true
